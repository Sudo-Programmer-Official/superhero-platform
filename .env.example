# Shared
ENV=development

# Database (same pattern as sibling projects)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=superhero_platform
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/superhero_platform
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/superhero_platform
DB_SCHEMA=superhero_platform

# API
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
LOG_LEVEL=INFO
LOG_FORMAT=json

# Firebase Auth
FIREBASE_PROJECT_ID=

# Storage (S3)
AWS_REGION=us-east-1
S3_BUCKET=openmat-media-prod
S3_PREFIX=superhero-platform
S3_PRESIGN_EXPIRES_SECONDS=900

# Frontend
VITE_API_BASE=http://localhost:8000/api/v1

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
